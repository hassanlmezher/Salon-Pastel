// Customer booking site on Cloudflare Workers (free plan, static files are free and unlimited).
// The admin site has its own pastel-admin/wrangler.jsonc.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pastel-booking",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Single-page app: every unknown path serves index.html.
    "not_found_handling": "single-page-application"
  },
  // Daily keep-alive for Supabase (see worker/index.ts).
  "triggers": { "crons": ["0 5 * * *"] },
  "vars": {
    "SUPABASE_URL": "https://owsgxkaupfuvkvzobfwv.supabase.co",
    "SUPABASE_ANON_KEY": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Im93c2d4a2F1cGZ1dmt2em9iZnd2Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODIyMDQyNTUsImV4cCI6MjA5Nzc4MDI1NX0.q4QOjDVEhdRIMmAzWs4gjREzXONxLCSZNZX-7R9Bfh0"
  },
  "observability": { "enabled": true }
}
