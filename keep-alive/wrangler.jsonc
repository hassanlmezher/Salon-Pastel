// Daily Supabase keep-alive (Cloudflare Workers free plan). It has no public address.
// Deploy with: npx wrangler deploy --config keep-alive/wrangler.jsonc
{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "pastel-keepalive",
  "main": "index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "preview_urls": false,
  "triggers": { "crons": ["0 5 * * *"] },
  "vars": {
    "SUPABASE_URL": "https://owsgxkaupfuvkvzobfwv.supabase.co",
    "SUPABASE_ANON_KEY": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Im93c2d4a2F1cGZ1dmt2em9iZnd2Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODIyMDQyNTUsImV4cCI6MjA5Nzc4MDI1NX0.q4QOjDVEhdRIMmAzWs4gjREzXONxLCSZNZX-7R9Bfh0"
  },
  "observability": { "enabled": true }
}
