// Owner admin site: static files (next build -> out/) served by a Workers static-assets
// Worker, free plan. No server code runs per request; the browser talks to Supabase directly.
// Its public address is the Pages project in pages-proxy/ (pastel-salon-admin.pages.dev).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pastel-admin",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./out",
    "not_found_handling": "404-page"
  },
  "observability": { "enabled": true }
}
